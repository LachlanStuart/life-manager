{
  "name": "life-manager",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "tsx server.ts",
    "demo": "tsx scripts/demo.ts",
    "dev": "tsx watch server.ts",
