{
  "name": "life-manager",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "tsx server.ts",
    "demo": "tsx scripts/demo.ts",
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build",
    "verify": "npm run typecheck && npm test && npm run build",
    "build:demo": "vite build --mode browser-demo --base=/life-manager/ --outDir=dist-demo",
    "preview:demo": "vite preview --mode browser-demo --base=/life-manager/ --outDir=dist-demo --host 127.0.0.1",
    "build:desktop": "npm run build && tsx scripts/build-desktop.ts",
    "desktop": "open \"release/Life Manager-darwin-arm64/Life Manager.app\"",
    "test:desktop": "tsx scripts/smoke-desktop.ts"
  },
  "dependencies": {
    "@mdxeditor/editor": "^4.0.1",
    "better-sqlite3": "^12.0.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.14.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@electron/rebuild": "^4.2.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "^1.4.11",
    "electron": "^44.5.1",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vite": "^7.3.1",
    "vitest": "^4.1.1"
  },
  "license": "MIT"
}
